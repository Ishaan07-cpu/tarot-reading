# Server Configuration
PORT=5000
NODE_ENV=production

# MongoDB Database URI (e.g. MongoDB Atlas connection string)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/tarot_reading?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_here_change_this

# Gmail SMTP Email Dispatch (Required for sending OTP verification codes)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_app_password
